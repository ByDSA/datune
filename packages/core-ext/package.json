{
  "private": true,
  "name": "@datune/core-ext",
  "version": "0.0.1",
  "description": "Datune - core extension",
  "license": "UNLICENSED",
  "author": "Daniel Sales Álvarez <danisales.es@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByDSA/datune.git",
    "directory": "packages/core-ext"
  },
  "scripts": {
    "build": "bin/build.mjs",
    "check": "bin/check.mjs",
    "postinstall": "cd node_modules/canvas && pnpm install --ignore-workspace > /dev/null || true",
    "lint": "bin/lint.mjs",
    "reinstall": "bin/reinstall.mjs",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@datune/core": "file:../core/dist",
    "@datune/utils": "file:../utils/dist"
  },
  "devDependencies": {
    "canvas": "3.1.2",
    "chart.js": "4.5.0",
    "chartjs-node-canvas": "5.0.0"
  },
  "standard-version": {
    "scripts": {
      "postcommit": "pnpm docs && pnpm release:push"
    }
  }
}
